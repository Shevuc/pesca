import pygame
import random
import os

# --------------------------------------------------
# 1. INICIALIZACAO E CONFIGURACAO DA JANELA
# --------------------------------------------------

pygame.init()

LARGURA = 900
ALTURA = 600

ecra = pygame.display.set_mode((LARGURA, ALTURA))
pygame.display.set_caption("Jogo da Pesca")

relogio = pygame.time.Clock()

# Caminho da pasta onde estao guardadas as imagens
PASTA_ASSETS = os.path.join(os.path.dirname(__file__), "assets")

# Carregar as imagens
fundo = pygame.image.load(os.path.join("images/fundo.png")).convert()
barco_imagem = pygame.image.load(os.path.join("images/barco.png")).convert_alpha()
peixe_imagem = pygame.image.load(os.path.join("images/peixe.png")).convert_alpha()
bota_imagem = pygame.image.load(os.path.join("images/bota.png")).convert_alpha()

# Ajustar o tamanho das imagens
barco_imagem = pygame.transform.scale(barco_imagem, (180, 105))
peixe_imagem = pygame.transform.scale(peixe_imagem, (75, 48))
bota_imagem = pygame.transform.scale(bota_imagem, (48, 48))

# Cores e tipos de letra
BRANCO = (255, 255, 255)
PRETO = (0, 0, 0)
AZUL_ESCURO = (5, 35, 75)
VERMELHO = (230, 50, 50)

fonte = pygame.font.SysFont("arial", 30, bold=True)
fonte_grande = pygame.font.SysFont("arial", 58, bold=True)
fonte_pequena = pygame.font.SysFont("arial", 22)

# --------------------------------------------------
# 2. VARIAVEIS DO JOGO
# --------------------------------------------------

velocidade_barco = 6
velocidade_anzol = 5

# O barco fica junto a superficie da agua
barco = pygame.Rect(350, 75, 180, 105)

pontos = 0
vidas = 3

# Estados do anzol: "parado", "descer" ou "subir"
estado_anzol = "parado"
anzol_x = barco.centerx
anzol_y = 170

# Lista onde ficam guardados os peixes e as botas
objetos = []

# Estado geral do jogo
estado_jogo = "a_jogar"

# Temporizador para criar objetos de vez em quando
tempo_ultimo_objeto = 0
intervalo_objetos = 1400


# --------------------------------------------------
# 3. FUNCOES
# --------------------------------------------------

def criar_objeto():
    """Cria um peixe ou uma bota numa altura aleatoria."""
    tipo = random.choice(["peixe", "peixe", "bota"])

    y = random.randint(220, 500)

    if tipo == "peixe":
        imagem = peixe_imagem
        largura = 75
        altura = 48
        velocidade = random.randint(2, 4)
    else:
        imagem = bota_imagem
        largura = 48
        altura = 48
        velocidade = random.randint(2, 3)

    # O objeto comeca fora do lado esquerdo do ecra
    rect = pygame.Rect(-largura, y, largura, altura)

    objeto = {
        "tipo": tipo,
        "rect": rect,
        "imagem": imagem,
        "velocidade": velocidade
    }

    objetos.append(objeto)


def reiniciar_jogo():
    """Coloca todas as variaveis no estado inicial."""
    global pontos, vidas, estado_anzol
    global anzol_x, anzol_y, estado_jogo
    global objetos, barco, tempo_ultimo_objeto

    pontos = 0
    vidas = 3
    estado_anzol = "parado"
    anzol_x = barco.centerx
    anzol_y = 170
    estado_jogo = "a_jogar"
    objetos = []
    barco.x = 350
    tempo_ultimo_objeto = pygame.time.get_ticks()


def escrever(texto, tipo_fonte, cor, x, y, centro=False):
    """Mostra texto no ecra."""
    imagem_texto = tipo_fonte.render(texto, True, cor)
    rect_texto = imagem_texto.get_rect()

    if centro:
        rect_texto.center = (x, y)
    else:
        rect_texto.topleft = (x, y)

    ecra.blit(imagem_texto, rect_texto)


# Criar os primeiros objetos
for i in range(3):
    criar_objeto()


# --------------------------------------------------
# 4. CICLO PRINCIPAL DO JOGO
# --------------------------------------------------

a_correr = True

while a_correr:

    # Limitar o jogo a 60 imagens por segundo
    relogio.tick(60)

    # --------------------------------------------------
    # FASE 1 - EVENTOS
    # --------------------------------------------------

    for evento in pygame.event.get():

        if evento.type == pygame.QUIT:
            a_correr = False

        if evento.type == pygame.KEYDOWN:

            # ESC fecha o jogo
            if evento.key == pygame.K_ESCAPE:
                a_correr = False

            # ESPACO lanca o anzol
            if evento.key == pygame.K_SPACE and estado_jogo == "a_jogar":
                if estado_anzol == "parado":
                    estado_anzol = "descer"

            # R recomeça quando o jogo termina
            if evento.key == pygame.K_r and estado_jogo == "fim":
                reiniciar_jogo()

    # --------------------------------------------------
    # FASE 2 - ATUALIZAR O JOGO
    # --------------------------------------------------

    if estado_jogo == "a_jogar":

        teclas = pygame.key.get_pressed()

        # Movimento do barco para a esquerda
        if teclas[pygame.K_LEFT]:
            barco.x -= velocidade_barco

        # Movimento do barco para a direita
        if teclas[pygame.K_RIGHT]:
            barco.x += velocidade_barco

        # Impedir que o barco saia da janela
        if barco.left < 0:
            barco.left = 0

        if barco.right > LARGURA:
            barco.right = LARGURA

        # Quando o anzol esta parado, acompanha o barco
        if estado_anzol == "parado":
            anzol_x = barco.centerx
            anzol_y = 170

        # Fazer o anzol descer
        elif estado_anzol == "descer":
            anzol_y += velocidade_anzol

            # Quando chega perto do fundo, comeca a subir
            if anzol_y >= 530:
                estado_anzol = "subir"

        # Fazer o anzol subir
        elif estado_anzol == "subir":
            anzol_y -= velocidade_anzol

            # Quando chega ao barco, fica parado
            if anzol_y <= 170:
                estado_anzol = "parado"

        # Criar novos peixes e botas de tempos a tempos
        tempo_atual = pygame.time.get_ticks()

        if tempo_atual - tempo_ultimo_objeto > intervalo_objetos:
            criar_objeto()
            tempo_ultimo_objeto = tempo_atual

        # Mover os objetos e verificar se sairam do ecra
        for objeto in objetos:
            objeto["rect"].x += objeto["velocidade"]

            # Se sair pelo lado direito, volta a aparecer do lado esquerdo
            if objeto["rect"].left > LARGURA:
                objeto["rect"].right = 0
                objeto["rect"].y = random.randint(220, 500)

        # Criar o retangulo de colisao do anzol
        anzol_rect = pygame.Rect(anzol_x - 12, anzol_y - 8, 24, 28)

        # Verificar colisoes entre o anzol e os objetos
        if estado_anzol == "descer" or estado_anzol == "subir":

            for objeto in objetos[:]:

                if anzol_rect.colliderect(objeto["rect"]):

                    if objeto["tipo"] == "peixe":
                        pontos += 1
                    else:
                        vidas -= 1

                    # Retirar o objeto apanhado da lista
                    objetos.remove(objeto)

                    # O anzol começa a subir depois de apanhar algo
                    estado_anzol = "subir"

                    # Se ficar sem vidas, termina o jogo
                    if vidas <= 0:
                        estado_jogo = "fim"

                    break

    # --------------------------------------------------
    # FASE 3 - DESENHAR
    # --------------------------------------------------

    # Desenhar o fundo
    ecra.blit(fundo, (0, 0))

    # Desenhar o barco
    ecra.blit(barco_imagem, barco)

    # Desenhar a linha e o anzol quando nao esta parado
    if estado_anzol != "parado":
        pygame.draw.line(
            ecra,
            (245, 245, 245),
            (barco.centerx, 145),
            (anzol_x, anzol_y),
            3
        )

        # Desenhar o anzol
        pygame.draw.arc(
            ecra,
            (210, 210, 220),
            (anzol_x - 9, anzol_y - 5, 20, 25),
            0,
            3.14,
            4
        )

    # Desenhar todos os peixes e botas
    for objeto in objetos:
        ecra.blit(objeto["imagem"], objeto["rect"])

    # Painel da pontuacao
    pygame.draw.rect(ecra, AZUL_ESCURO, (15, 12, 220, 48), border_radius=12)
    escrever("Pontos: " + str(pontos), fonte, BRANCO, 28, 20)

    # Painel das vidas
    pygame.draw.rect(ecra, AZUL_ESCURO, (700, 12, 185, 48), border_radius=12)
    escrever("Vidas: " + str(vidas), fonte, BRANCO, 720, 20)

    # Instrucoes
    escrever("Setas: mover barco", fonte_pequena, BRANCO, 15, 565)
    escrever("ESPACO: lancar / recolher anzol", fonte_pequena, BRANCO, 270, 565)

    # Ecrã de fim de jogo
    if estado_jogo == "fim":

        # Escurecer o ecra
        camada = pygame.Surface((LARGURA, ALTURA))
        camada.set_alpha(180)
        camada.fill((0, 0, 0))
        ecra.blit(camada, (0, 0))

        escrever("FIM DE JOGO", fonte_grande, BRANCO,
                 LARGURA // 2, 230, True)

        escrever("Pontuacao final: " + str(pontos), fonte,
                 BRANCO, LARGURA // 2, 305, True)

        escrever("Carrega em R para recomecar", fonte,
                 BRANCO, LARGURA // 2, 375, True)

        escrever("ESC para sair", fonte_pequena,
                 BRANCO, LARGURA // 2, 425, True)

    # Atualizar a imagem apresentada
    pygame.display.flip()


# Fechar o Pygame corretamente
pygame.quit()
